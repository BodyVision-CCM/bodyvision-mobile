<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Nom affiché par le lanceur. -->
    <string name="app_name">BodyVision</string>

    <!-- Permission refusée, mais une explication peut encore être montrée. On dit à quoi sert
         la caméra et ce qu'il advient des images, parce que c'est la question que se pose
         quelqu'un qui vient de refuser. -->
    <string name="camera_permission_denied_message">BodyVision a besoin de la caméra pour analyser votre posture pendant l’exercice. L’analyse se fait sur le téléphone : aucune image n’est enregistrée ni envoyée.</string>
    <!-- Refus définitif : Android ne réaffichera plus la demande, seuls les réglages restent. -->
    <string name="camera_permission_blocked_message">L’accès à la caméra est bloqué. Autorisez-le dans les réglages de l’application, puis revenez ici.</string>
    <!-- Erreur critique : la caméra ne reviendra pas d'elle-même, d'où le bouton « Réessayer ». -->
    <string name="camera_unavailable_message">La caméra n’est pas disponible. Une autre application l’utilise peut-être.</string>
    <!-- Erreur récupérable, affichée en bandeau par-dessus l'aperçu. Le texte couvre les trois
         codes récupérables, pas seulement la caméra occupée, et n'invite à aucune action :
         CameraX réouvre tout seul. -->
    <string name="camera_recovering_message">Caméra momentanément indisponible. L’aperçu reprend dès qu’elle se libère.</string>

    <!-- Les deux compteurs de SCRUM-32, posés sur l'aperçu : images analysées par seconde,
         puis points du squelette dans la dernière pose. Une seule ligne, parce que c'est une
         seule information : est-ce que la détection tourne, et voit-elle quelqu'un. -->
    <string name="session_counters">%1$d FPS · %2$s</string>
    <!-- En français 0 et 1 prennent le singulier, et 0 s'affiche dès qu'on sort du cadre. -->
    <plurals name="session_landmark_count">
        <item quantity="one">%d point</item>
        <item quantity="other">%d points</item>
    </plurals>

    <string name="action_retry">Réessayer</string>
    <string name="action_open_settings">Ouvrir les réglages</string>
</resources>
