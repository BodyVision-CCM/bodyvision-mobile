<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Aucune caméra n'est exigée : l'application s'installe sur un appareil qui n'en a pas
         plutôt que d'être filtrée par le magasin. L'absence de caméra fait échouer la liaison
         CameraX, qui aboutit à l'écran « caméra indisponible ».

         Les deux dernières lignes ne sont pas redondantes avec la première : déclarer la
         permission CAMERA fait implicitement exiger « android.hardware.camera » ET
         « android.hardware.camera.autofocus » en required=true, et « camera.any » est un
         troisième nom de fonctionnalité qui ne les remplace pas. Sans ces deux surcharges
         explicites, le filtrage reste en place. -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BodyVision">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
